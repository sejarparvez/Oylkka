model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  imageUrl      String?
  imagePublicId String?

  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("SubCategories")

  products Product[]

  featured Boolean @default(false)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("category")
}

model Product {
  id          String @id @default(cuid())
  productName String
  slug        String @unique
  description String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onUpdate: NoAction)

  tags  String[]
  sku   String   @unique
  brand String?

  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)

  hasVariants   Boolean @default(false)
  stock         Int     @default(0)
  lowStockAlert Int     @default(5)

  condition            ProductCondition
  conditionDescription String?

  weight       Float?
  weightUnit   String  @default("kg")
  freeShipping Boolean @default(false)

  dimensionLength Float?
  dimensionWidth  Float?
  dimensionHeight Float?
  dimensionUnit   String @default("cm")

  images ProductImage[]

  variants              ProductVariant[]
  attributeOptions      ProductAttributeOption[]
  globalAttributeValues ProductGlobalAttributeValue[]

  metaTitle       String?
  metaDescription String?

  status   ProductStatus @default(PUBLISHED)
  featured Boolean       @default(false)

  shopId String?
  shop   Shop?   @relation("ShopProducts", fields: [shopId], references: [id], onUpdate: NoAction)

  createdBy String
  user      User   @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  reviews       Review[]
  reports       ProductReport[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  questions     ProductQuestion[]

  views Int @default(0)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
  conversations Conversation[]

  @@index([categoryId])
  @@index([createdBy])
  @@index([shopId])
  @@index([status])
  @@index([featured])
  @@map("product")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl      String
  imagePublicId String
  altText       String?
  order         Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_image")
}

model ProductAttributeValue {
  id       String                 @id @default(cuid())
  optionId String
  option   ProductAttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  value        String
  slug         String
  displayOrder Int    @default(0)

  // Metadata
  imageUrl      String?
  imagePublicId String?
  metadata      Json?

  // Price modifier for Matrix Pricing (Phase 6)
  priceModifier            Decimal?                  @db.Decimal(10, 2)
  productVariantAttributes ProductVariantAttribute[]

  @@unique([optionId, slug])
  @@index([optionId])
  @@map("product_attribute_value")
}

model ProductAttributeOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name   String
  values String[]

  isVariantDefining Boolean @default(true)
  displayOrder      Int     @default(0)

  attributeValues ProductAttributeValue[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_attribute_option")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name String
  sku  String @unique

  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)

  stock Int @default(0)

  attributes Json

  imageUrl      String?
  imagePublicId String?

  // NEW — inventory control
  status        VariantStatus @default(ACTIVE)
  reservedStock Int           @default(0)
  lowStockAlert Int?
  barcode       String?

  // NEW — shipping per variant (critical for multivendor)
  weight          Float?
  weightUnit      String  @default("kg")
  dimensionLength Float?
  dimensionWidth  Float?
  dimensionHeight Float?
  dimensionUnit   String  @default("cm")
  freeShipping    Boolean @default(false)

  // NEW — pre-order support
  availableAt DateTime?

  // NEW — optional SEO slug (e.g., "red-large" for /product/t-shirt/red-large)
  slug String?

  cartItems CartItem[]

  // Phase 3 — Referential Integrity Join
  attributeValues ProductVariantAttribute[]

  // Phase 4 — Multi-Image Variants
  variantImages ProductVariantImage[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variant")
}

model ProductVariantAttribute {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   ProductAttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@index([variantId])
  @@map("product_variant_attribute")
}

// ──────────────────────────────────────────────
// Phase 5 — Global Attribute Taxonomy
// ──────────────────────────────────────────────

model GlobalAttribute {
  id           String @id @default(cuid())
  name         String
  slug         String @unique
  displayOrder Int    @default(0)

  values       GlobalAttributeValue[]
  productLinks ProductGlobalAttributeValue[]

  @@map("global_attribute")
}

model GlobalAttributeValue {
  id          String          @id @default(cuid())
  attributeId String
  attribute   GlobalAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  value String
  slug  String

  // Structured metadata (e.g. {"hex": "#FF0000"} for color)
  metadata Json?

  productLinks ProductGlobalAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@map("global_attribute_value")
}

model ProductGlobalAttributeValue {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  globalAttributeId String
  globalAttribute   GlobalAttribute @relation(fields: [globalAttributeId], references: [id])

  // References the local ProductAttributeValue
  localValueId String

  // References the GlobalAttributeValue this local value maps to
  globalValueId String
  globalValue   GlobalAttributeValue @relation(fields: [globalValueId], references: [id])

  @@unique([productId, globalAttributeId, localValueId])
  @@index([globalAttributeId])
  @@index([globalValueId])
  @@index([productId])
  @@map("product_global_attribute_value")
}

model ProductVariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  imageUrl      String
  imagePublicId String
  altText       String?
  order         Int     @default(0)

  @@index([variantId])
  @@map("product_variant_image")
}

model ProductQuestion {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  question String

  answer         String?
  answeredAt     DateTime?
  answeredBy     String?
  answeredByUser User?     @relation(name: "answeredByUser", fields: [answeredBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@map("product_question")
}
