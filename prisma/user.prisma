model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)

  imageUrl      String  @default("")
  imagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role             UserRole  @default(USER)
  banned           Boolean   @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean   @default(false)

  sessions           Session[]
  accounts           Account[]
  products           Product[]
  reviews            Review[]
  reviewHelpfulVotes ReviewHelpfulVote[]
  wishlistItems      WishlistItem[]
  cart               Cart?
  shop               Shop?
  orders             Order[]
  vouchers           UserVoucher[]
  wallet             Wallet?
  walletTopUps       WalletTopUp[]
  returnRequests     ReturnRequest[]
  shopFollows        ShopFollow[]
  addresses          UserAddress[]
  productReports     ProductReport[]
  conversations      Conversation[]   // as customer
  messages           Message[]       // as sender
  questions          ProductQuestion[]
  answeredQuestions  ProductQuestion[] @relation("answeredByUser")
  bkashTokens        BkashToken[]
  twoFactor          TwoFactor[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String? @db.Text
  refreshToken String? @db.Text
  idToken      String? @db.Text

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model TwoFactor {
  id          String   @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}
