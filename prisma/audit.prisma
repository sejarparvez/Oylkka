model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorRole String

  action     String
  entity     String
  entityId   String
  details    Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  // No unique constraint on (actorId, action, entity, entityId): the audit
  // trail must be able to hold repeat history, so it is indexed for reads
  // instead. See migration 20261003100200.
  @@index([actorId])
  @@index([action])
  @@index([entity, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}
